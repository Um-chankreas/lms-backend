# Copy to .env and fill in real values. .env is gitignored.
#
# One .env per machine:
#   local machine     -> NODE_ENV=development + your personal Supabase project
#   production server  -> NODE_ENV=production  + the company Supabase project
#
# Real host env vars (systemd / pm2 / Docker / hosting dashboard) override this file.

PORT=5001
NODE_ENV=development

# Supabase — use a DIFFERENT project on local vs production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Auth — REQUIRED: the server refuses to start without a random secret of 32+
# characters. Generate one with:  openssl rand -hex 32
# Changing it logs everyone out (all existing tokens stop working).
JWT_SECRET=
JWT_EXPIRE=7d

# Agora (live classes)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# CORS — comma-separated browser origins allowed to call the API.
# "*" allows any origin. Unset: any origin in development, only
# https://web.romduolscholars.com in production. (The mobile app sends no
# Origin header and is never affected.)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy hops to trust for the client IP (rate limiting). Defaults to 1
# in production (Caddy in front), off in development.
# TRUST_PROXY=1

# Phone numbers without a country code are assumed to be from this country
PHONE_DEFAULT_COUNTRY_CODE=+855

# Mobile app version gate (see src/routes/appVersion.routes.js). All optional —
# unset values come back null and the app shows nothing. Restart the server
# after changing any of these.
APP_LATEST_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
APP_MIN_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
APP_RELEASE_NOTES=
