# Copy to .env and fill in real values. .env is gitignored.
#
# One .env per machine:
#   local machine     -> NODE_ENV=development + your personal Supabase project
#   production server -> NODE_ENV=production  + the company Supabase project
#
# Real host env vars (systemd / pm2 / Docker / hosting dashboard) override this file.

# --- Server ---
PORT=5001
NODE_ENV=development

# --- Supabase (use a DIFFERENT project on local vs production) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# --- Auth ---
# REQUIRED: the server refuses to start without a random secret of 32+
# characters. Generate one with:  openssl rand -hex 32
# Changing it logs everyone out (all existing tokens stop working).
JWT_SECRET=
JWT_EXPIRE=7d

# --- Agora (live classes) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional. Token lifetime in seconds (default 14400 = 4h)
# AGORA_TOKEN_TTL_SECONDS=14400
# Usage page: monthly free minutes on your Agora plan (free plan = 10000).
# AGORA_FREE_MINUTES=10000
# Optional: the Agora login email for this default account (shown on the usage page).
# AGORA_ACCOUNT_EMAIL=
# Raise above 1 if video minutes are billed at a higher weight (HD etc.).
# AGORA_MINUTES_MULTIPLIER=1
# Cut off a stay that never reported leaving after this many hours.
# AGORA_SESSION_MAX_HOURS=6
# Optional. Minutes to wait for a disconnected teacher before ending (default 3)
# LIVE_CLASS_TEACHER_GRACE_MIN=3
# Optional. Deep-link base for join URLs (default lms://live-class)
# LIVE_CLASS_JOIN_URL_BASE=lms://live-class

# --- CORS ---
# Comma-separated browser origins allowed to call the API.
# "*" allows any origin. Unset: any origin in development, only
# https://web.romduolscholars.com in production. (The mobile app sends no
# Origin header and is never affected.)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy hops to trust for the client IP (rate limiting). Defaults to 1
# in production (Caddy in front), off in development.
# TRUST_PROXY=1

# --- Phone numbers ---
# Numbers without a country code are assumed to be from this country
PHONE_DEFAULT_COUNTRY_CODE=+855

# --- Mobile app version gate (see src/routes/appVersion.routes.js) ---
# All optional — unset values come back null and the app shows nothing.
# Restart the server after changing any of these.
APP_LATEST_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
APP_MIN_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
APP_RELEASE_NOTES=

# Textbook storage — the national MoEYS PDFs live in a separate Supabase
# project from this server's database (see src/config/textbookStorage.js).
# Leave blank to serve an empty Library shelf.
TEXTBOOK_SUPABASE_URL=
TEXTBOOK_S3_ENDPOINT=
TEXTBOOK_S3_REGION=us-east-1
TEXTBOOK_S3_ACCESS_KEY=
TEXTBOOK_S3_SECRET_KEY=
